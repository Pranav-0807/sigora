# Copy this file to .env for local development.
# Never commit the real .env file.

SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=dbname=sigora

# AI options: gemini or ollama
AI_ENABLED=1
AI_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.6-flash

# For local Ollama:
# AI_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434/api/generate
# OLLAMA_MODEL=qwen3:8b

FLASK_DEBUG=0
SESSION_COOKIE_SECURE=0

# Transactional email / alerts
RESEND_API_KEY=
EMAIL_FROM=no-reply@sigorafinance.com
PUBLIC_BASE_URL=https://sigorafinance.com
# Optional SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=


# Sigora AI usage controls
FREE_AI_MONTHLY_LIMIT=5
PREMIUM_AI_MONTHLY_LIMIT=30
FREE_AI_DAILY_LIMIT=2
PREMIUM_AI_DAILY_LIMIT=5
PREMIUM_PRICE=149
# Regional Premium prices (fixed local pricing; override as needed)
SIGORA_PREMIUM_PRICE_INR=149
SIGORA_PREMIUM_PRICE_USD=1.99
SIGORA_PREMIUM_PRICE_EUR=1.99
SIGORA_PREMIUM_PRICE_GBP=1.49
SIGORA_PREMIUM_PRICE_CAD=2.99
SIGORA_PREMIUM_PRICE_AUD=2.99
SIGORA_PREMIUM_PRICE_CHF=1.99
SIGORA_PREMIUM_PRICE_SGD=2.99
SIGORA_PREMIUM_PRICE_AED=7.99
SIGORA_PREMIUM_PRICE_JPY=299
SIGORA_PREMIUM_PRICE_NZD=3.49
SIGORA_PREMIUM_PRICE_ZAR=39

# Optional support email (leave blank until you create one)
SIGORA_SUPPORT_EMAIL=support.sigora@gmail.com

# Razorpay: leave blank until your merchant account is ready
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
# Optional Razorpay subscription plan IDs for international billing currencies.
# Checkout stays disabled for a currency until its matching plan exists.
RAZORPAY_PLAN_ID_USD=
RAZORPAY_PLAN_ID_EUR=
RAZORPAY_PLAN_ID_GBP=
RAZORPAY_PLAN_ID_CAD=
RAZORPAY_PLAN_ID_AUD=
RAZORPAY_PLAN_ID_CHF=
RAZORPAY_PLAN_ID_SGD=
RAZORPAY_PLAN_ID_AED=
RAZORPAY_PLAN_ID_JPY=
RAZORPAY_PLAN_ID_NZD=
RAZORPAY_PLAN_ID_ZAR=
RAZORPAY_TOTAL_COUNT=120

# Import safety / performance
IMPORT_MAX_FILE_MB=25
IMPORT_MAX_ROWS=10000

# Application-level Gemini spend guardrail (not a Google Cloud billing budget)
AI_MONTHLY_BUDGET_USD=5
AI_ESTIMATED_COST_PER_REQUEST_USD=0.01
AI_GLOBAL_MONTHLY_REQUEST_LIMIT=2000


# Google Analytics 4
SIGORA_GA4_MEASUREMENT_ID=

# India Account Aggregator (Setu)
# Leave blank until Setu FIU sandbox/production onboarding is complete.
SETU_AA_BASE_URL=https://fiu.setu.co
SETU_AA_AUTH_URL=https://accountservice.setu.co/v1/users/login
SETU_AA_CLIENT_ID=
SETU_AA_CLIENT_SECRET=
SETU_AA_PRODUCT_INSTANCE_ID=
SETU_AA_FIU_ID=
SETU_AA_REDIRECT_URL=
SETU_AA_PURPOSE_CODE=101
SETU_AA_PURPOSE_TEXT=Personal financial management
SETU_AA_FETCH_TYPE=PERIODIC
SETU_AA_FREQUENCY_VALUE=1
SETU_AA_FREQUENCY_UNIT=MONTH
SETU_AA_DATA_LIFE_VALUE=1
SETU_AA_DATA_LIFE_UNIT=MONTH
SETU_AA_WEBHOOK_SECRET=

# Optional release label shown in Admin > System health
SIGORA_VERSION=launch-ready-2-admin-v1
